<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: also trust user-installed CAs, so the app works on
  networks that re-sign TLS with a corporate root (install it on the
  device/emulator under Settings > Security > Install a certificate).
  Release builds keep the platform default (system CAs only).
-->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
