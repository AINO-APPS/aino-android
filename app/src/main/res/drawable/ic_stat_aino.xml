        android:pathData="M12,2a3,3 0 0,1 3,3v6a3,3 0 0,1 -6,0v-6a3,3 0 0,1 3,-3z"
        android:strokeWidth="1.7"
        android:strokeColor="#FFFFFFFF"
        android:fillColor="#00000000" />
    <group
        android:rotation="-30"
        android:translateX="8"
        android:translateY="16">
        <path
            android:pathData="M-3,-3h6a3,3 0 0,1 0,6h-6a3,3 0 0,1 0,-6z"
            android:strokeWidth="1.7"
            android:strokeColor="#FFFFFFFF"
            android:fillColor="#00000000" />
    </group>
    <group
        android:rotation="30"
        android:translateX="16"
        android:translateY="16">
        <path
            android:pathData="M-3,-3h6a3,3 0 0,1 0,6h-6a3,3 0 0,1 0,-6z"
            android:strokeWidth="1.7"
            android:strokeColor="#FFFFFFFF"
            android:fillColor="#00000000" />
    </group>
