<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device-to-device transfer. Nothing is backed up: the
  app holds an encrypted sign-in token (its Keystore key never leaves the
  device, so a restored copy would be unusable) and a tenant-scoped work cache
  that must not leave the device. Everything is re-fetched after sign-in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
